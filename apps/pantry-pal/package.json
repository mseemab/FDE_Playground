{
  "name": "@apps/pantry-pal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types:gen": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e:db": "playwright test --config playwright.db.config.ts"
  },
  "dependencies": {
    "@factory/analytics": "workspace:*",
    "@factory/supabase": "workspace:*",
    "@factory/ui": "workspace:*",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@factory/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "postcss": "8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@supabase/ssr": "0.12.7"
  }
}
