# Copy to .env.local for local development. Never commit .env.local.

# PostHog project API key (starts with phc_). Optional locally: analytics is disabled without it.
# Required when VERCEL_ENV=production. Get it from PostHog > Project settings > Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase. Leave empty locally to use the local stack (`pnpm --filter pantry-pal db:start`).
# Required on Vercel: Supabase dashboard > Project Settings > API Keys (publishable key) and
# Project Settings > Data API (project URL, https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth for the LOCAL Supabase stack only (read by supabase/config.toml at `db:start`).
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI for local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
