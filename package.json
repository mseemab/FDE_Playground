{
  "name": "factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test && pnpm check:repo",
    "check:affected": "TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/main} turbo run lint typecheck test --affected && pnpm check:repo",
    "check:repo": "pnpm --filter @factory/tools check:repo",
    "check:rls": "pnpm --filter @factory/tools check:rls",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-project": "pnpm --filter @factory/tools exec tsx new-project.ts"
  },
  "devDependencies": {
    "@factory/config": "workspace:*",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.3"
  }
}
