  "devDependencies": {
    "@factory/config": "workspace:*",
    "@types/node": "24.x",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
